# Environment mode: development | production
ENVIRONMENT=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-cryptographically-strong-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database configuration (MySQL 8+ / 9+)
DB_ENGINE=django.db.backends.mysql
DB_NAME=attribution_iq
DB_USER=root
DB_PASSWORD=replace-with-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

# SimpleJWT Token Lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS Origins for React / Vite frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Attribution Engine Defaults
DEFAULT_ATTRIBUTION_MODEL=position_based
DEFAULT_CONVERSION_WINDOW_DAYS=90
TIME_DECAY_HALF_LIFE_DAYS=7
DEFAULT_CURRENCY=USD

# Email Backend (console in dev, SMTP in prod)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@attributioniq.io

# Production HTTPS Hardening (used when DJANGO_SETTINGS_MODULE=config.settings_prod)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=31536000

